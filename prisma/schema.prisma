generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  password      String
  plan          String        @default("free")
  usageCount    Int           @default(0)
  createdAt     DateTime      @default(now())
  chats         Chat[]
  documents     Document[]
  brandVoices   BrandVoice[]
}

model Chat {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  prompt    String
  response  String
  createdAt DateTime @default(now())
}

model Document {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  title      String
  type       String
  content    String
  favorite   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BrandVoice {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  tone        String
  description String
  traits      String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
}